# Leave DATABASE_URL unset to run entirely from CSV files (recommended first run).
# DATABASE_URL=postgresql+psycopg2://churn:churn@localhost:5433/churnradar

# Which CSV the API reads when DATABASE_URL is not set.
# Point this at data/sample/scored_customers.csv to run on the committed sample.
SCORED_CSV=data/scored_customers.csv

# Probability above which an account counts as "at risk".
RISK_THRESHOLD=0.15

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
